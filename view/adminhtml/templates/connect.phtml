<?php
/**
 * @var \Magento\Backend\Block\Template $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Friendzy\Widget\ViewModel\ConnectPage $viewModel
 */
$viewModel = $block->getData('view_model');
$waiting = $viewModel->waitingStore();
$post = $block->getUrl('friendzy/connect/post');
$disconnect = $block->getUrl('friendzy/connect/disconnect');
$formKey = $block->getFormKey();
?>
<p>
    <?= $escaper->escapeHtml(__('Sign in with your Friendzy account to put Friendzy on a store view.')) ?>
    <?= $escaper->escapeHtml(__('We keep only the site ID, not your password.')) ?>
</p>
<?php if ($waiting > 0): ?>
    <form method="post" action="<?= $escaper->escapeUrl($post) ?>">
        <input type="hidden" name="form_key" value="<?= $escaper->escapeHtmlAttr($formKey) ?>">
        <label><?= $escaper->escapeHtml(__('Code from your authenticator, or a recovery code')) ?>
            <input class="admin__control-text" type="text" name="code" autocomplete="one-time-code" required>
        </label>
        <button class="action-primary" type="submit"><?= $escaper->escapeHtml(__('Continue')) ?></button>
    </form>
<?php endif; ?>
<?php foreach ($viewModel->stores() as $store): ?>
    <h2><?= $escaper->escapeHtml($store['name']) ?></h2>
    <?php if ($store['site'] !== ''): ?>
        <form method="post" action="<?= $escaper->escapeUrl($disconnect) ?>">
            <input type="hidden" name="form_key" value="<?= $escaper->escapeHtmlAttr($formKey) ?>">
            <input type="hidden" name="store" value="<?= (int) $store['id'] ?>">
            <p><?= $escaper->escapeHtml(__('Connected: %1', $store['site'])) ?></p>
            <p><?= $escaper->escapeHtml(__('Your shoppers see the button once Friendzy has checked this store view and Live is on in your Friendzy admin.')) ?></p>
            <p><a href="<?= $escaper->escapeUrl($viewModel->adminUrl()) ?>" target="_blank" rel="noopener"><?= $escaper->escapeHtml(__('Open your Friendzy admin')) ?></a></p>
            <button type="submit"><?= $escaper->escapeHtml(__('Disconnect')) ?></button>
        </form>
    <?php else: ?>
        <form method="post" action="<?= $escaper->escapeUrl($post) ?>">
            <input type="hidden" name="form_key" value="<?= $escaper->escapeHtmlAttr($formKey) ?>">
            <input type="hidden" name="store" value="<?= (int) $store['id'] ?>">
            <label><?= $escaper->escapeHtml(__('Email')) ?>
                <input class="admin__control-text" type="email" name="email" autocomplete="off" required>
            </label>
            <label><?= $escaper->escapeHtml(__('Password')) ?>
                <input class="admin__control-text" type="password" name="password" autocomplete="off" required>
            </label>
            <button class="action-primary" type="submit"><?= $escaper->escapeHtml(__('Connect')) ?></button>
        </form>
    <?php endif; ?>
<?php endforeach; ?>
