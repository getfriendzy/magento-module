<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="head.additional">
            <block class="Magento\Framework\View\Element\Template" name="friendzy.private.page" template="Friendzy_Widget::private-page.phtml"/>
        </referenceBlock>
        <referenceContainer name="before.body.end">
            <block class="Magento\Framework\View\Element\Template" name="friendzy.order.line" template="Friendzy_Widget::order-line.phtml" cacheable="false">
                <arguments>
                    <argument name="view_model" xsi:type="object">Friendzy\Widget\ViewModel\OrderLine</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
